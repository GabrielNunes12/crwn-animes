# Copy to server/.env and adjust. Every variable is optional in development.

# "development" (default) or "production". Production turns on Secure cookies,
# removes GET /api/dev/outbox, never prints e-mail links to the console, and
# REQUIRES SMTP_HOST (the server refuses to start without it, since nobody could
# verify their e-mail or reset a password). Always set it on a real deployment.
NODE_ENV=development
# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000
# SQLite database file, relative to server/ (":memory:" for a throwaway DB).
DATABASE_FILE=./data/crwn-animes.db
# Built React app (its index.html) served in production, relative to server/.
# Default: ../client/dist. Served only when <CLIENT_DIST>/index.html exists.
CLIENT_DIST=

# Video thumbnails are served from this origin (GET /api/thumbs/<id>.jpg): the server
# fetches them from i.ytimg.com, so visitors' browsers never contact Google before Play.
# Directory of the on-disk cache, relative to server/ (created on the first thumbnail).
# Give it a directory of its own: "<11-character id>.jpg" files that no video uses any
# more are deleted (videos deleted for good, hourly clean-up). Default: ./data/thumbs
THUMB_CACHE_DIR=./data/thumbs
# Maximum size of that cache in megabytes; beyond it the least recently served
# thumbnails are deleted. 0 keeps nothing on disk (every request goes to YouTube again).
THUMB_CACHE_MB=200

# Public URL of the React app; used to build links in e-mails (verify, reset),
# canonical URLs, Open Graph tags, sitemap.xml and robots.txt. REQUIRED in
# production, and it must be https:// (the server refuses to start otherwise).
APP_URL=http://localhost:5173
# Origin(s) allowed to call the API with cookies (CORS), comma separated. Only needed when
# the client is served from another origin. Outside production it defaults to the Vite dev
# server (http://localhost:5173); in production it defaults to none (same-origin only).
CLIENT_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy so rate limiting sees the real client IP:
# a hop count ("1" for one proxy) or a comma-separated list of proxy addresses /
# subnets ("10.0.0.0/8, loopback"). "true" is refused: it would let any client
# choose its own IP with X-Forwarded-For. Leave empty when not behind a proxy.
TRUST_PROXY=

# Accounts with these e-mails (comma separated, case-insensitive) become admins
# when they verify their e-mail or log in. `npm run make-admin -- <email>` also works.
ADMIN_EMAILS=

# Max attempts per 15 minutes on register / login / resend / forgot-password /
# reset-password (per IP), and on change-password / delete-account (per IP and per account).
RATE_LIMIT_MAX=10

# SMTP for real e-mails (required in production). Leave SMTP_HOST empty in
# development to keep e-mails in the in-memory dev outbox (GET /api/dev/outbox)
# and print the links to the console.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Otherwise STARTTLS is REQUIRED: the server
# refuses to send credentials or links over an unencrypted connection.
SMTP_SECURE=false
# Only for a trusted relay on the same machine (localhost) that cannot do TLS: "false".
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Sender shown on e-mails.
MAIL_FROM="Crwn Animes <no-reply@example.com>"
