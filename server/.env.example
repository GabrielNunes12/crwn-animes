# Copy to server/.env and adjust. Every variable is optional in development.

# "production" turns on Secure cookies and turns off GET /api/dev/outbox.
NODE_ENV=development
# Port the API listens on (the Vite dev server proxies /api here).
PORT=4000
# SQLite database file, relative to server/ (":memory:" for a throwaway DB).
DATABASE_FILE=./data/crwn-animes.db

# Public URL of the React app; used to build links in e-mails (verify, reset).
APP_URL=http://localhost:5173
# Origin(s) allowed to call the API with cookies (CORS), comma separated.
CLIENT_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy so rate limiting sees the real client IP
# (e.g. "1" for one proxy hop, or "loopback"). Leave empty when not behind a proxy.
TRUST_PROXY=

# Accounts with these e-mails (comma separated, case-insensitive) become admins
# when they verify their e-mail or log in. `npm run make-admin -- <email>` also works.
ADMIN_EMAILS=

# Max attempts per IP per 15 minutes on register / login / resend / forgot-password.
RATE_LIMIT_MAX=10

# SMTP for real e-mails. Leave SMTP_HOST empty to keep e-mails in the in-memory
# dev outbox (GET /api/dev/outbox) and print the links to the console.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); STARTTLS is used otherwise when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on e-mails.
MAIL_FROM="Crwn Animes <no-reply@example.com>"
